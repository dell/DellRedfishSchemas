                 <Parameter Name="SubSystemType" Type="DellSwitch.SubSystemType">
                    <Annotation Term="OData.Description" String="This parameter shall contain the SubSystemType"/>
                    <Annotation Term="OData.LongDescription" String="This parameter shall contain the SubSystemType"/>
                </Parameter>
                <ReturnType Type="DellSwitch.GetTraceSeverityResponse" Nullable="false"/>
            </Action>
            <ComplexType Name="GetTraceSeverityResponse">
                <Annotation Term="OData.AdditionalProperties" Bool="false"/>
                <Annotation Term="OData.Description" String="The response body for the GetTraceSeverity action."/>
                <Annotation Term="OData.LongDescription" String="This type shall contain the properties found in the response body for the GetTraceSeverity action."/>
