                <Annotation Term="OData.Description" String="This action is used to set the Broadcom Switch trace severity log options"/>
                <Annotation Term="OData.LongDescription" String="This action is used to set the Broadcom Switch trace severity log options"/>
                 <Parameter Name="DebugType" Type="DellSwitch.DebugType" Nullable="false">
                    <Annotation Term="OData.Description" String="This parameter shall contain the debug type required"/>
                    <Annotation Term="OData.LongDescription" String="This parameter shall contain the debug type required"/>
                </Parameter>
                 <Parameter Name="UpdateType" Type="DellSwitch.UpdateType">
                    <Annotation Term="OData.Description" String="This parameter shall contain the update type required"/>
