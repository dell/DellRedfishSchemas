                 <Parameter Name="TraceSeverity" Type="DellSwitch.TraceSeverity">
                    <Annotation Term="OData.Description" String="This parameter shall contain the TraceSeverity"/>
                    <Annotation Term="OData.LongDescription" String="This parameter shall contain the TraceSeverity"/>
                </Parameter>
                 <Parameter Name="SubSystemType" Type="DellSwitch.SubSystemType">
                    <Annotation Term="OData.Description" String="This parameter shall contain the SubSystemType"/>
                    <Annotation Term="OData.LongDescription" String="This parameter shall contain the SubSystemType"/>
                </Parameter>
                 <Parameter Name="TraceMask" Type="Edm.String">
                    <Annotation Term="OData.Description" String="This parameter shall contain the TraceMask"/>
                    <Annotation Term="OData.LongDescription" String="Please provide the TraceMask from the Broadcom ScrutinySwitch Healthconfig document when setting the SubSystemType level log. E.g. value 0x00000001"/>
