<!---->
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Core.V1.xml">
        <edmx:Include Alias="OData" Namespace="Org.OData.Core.V1"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://docs.oasis-open.org/odata/odata/v4.0/errata03/csd01/complete/vocabularies/Org.OData.Capabilities.V1.xml">
        <edmx:Include Alias="Capabilities" Namespace="Org.OData.Capabilities.V1"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/RedfishExtensions_v1.xml">
        <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Resource_v1.xml">
        <edmx:Include Namespace="Resource"/>
        <edmx:Include Namespace="Resource.v1_0_0"/>
        <edmx:Include Namespace="Resource.v1_2_0"/>
    </edmx:Reference>
    <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/SoftwareInventory_v1.xml">
        <edmx:Include Namespace="SoftwareInventory"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="DellOemSoftwareInventory">
            <Annotation Term="Redfish.OwningEntity" String="Dell"/>
            <!-- NEW: OEM ComplexType for SoftwareInventory.Oem.Dell -->
            <ComplexType Name="DellOemSoftwareInventory" Abstract="true">
                <Annotation Term="OData.AdditionalProperties" Bool="false"/>
                <Annotation Term="OData.Description" String="This property shall represent the OEM properties for a SoftwareInventory resource."/>
                <Annotation Term="OData.LongDescription" String="This complex type provides OEM extensions for the DMTF SoftwareInventory resource, including plugin inventory properties and Dell-specific extensions."/>
            </ComplexType>
            <!-- NEW: Actions from DellPluginInventory -->
            <Action Name="Restart" IsBound="true">
                <Parameter Name="SoftwareInventory" Type="SoftwareInventory.v1_0_0.OemActions" Nullable="false"/>
                <Annotation Term="OData.Description" String="The Restart operation shall restart plugin instance present in SoftwareInventory."/>
                <Annotation Term="OData.LongDescription" String="The Restart operation shall restart plugin instance present in SoftwareInventory."/>
                <Annotation Term="Redfish.Revisions">
                    <Collection>
                        <Record>
                            <PropertyValue Property="Kind" EnumMember="Redfish.RevisionKind/Added"/>
                            <PropertyValue Property="Version" String="v1_0_0"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Action>
            <Action Name="Uninstall" IsBound="true">
                <Parameter Name="SoftwareInventory" Type="SoftwareInventory.v1_0_0.OemActions" Nullable="false"/>
                <Annotation Term="OData.Description" String="The Uninstall operation shall remove plugin instance present in SoftwareInventory."/>
                <Annotation Term="OData.LongDescription" String="The Uninstall operation shall remove plugin instance present in SoftwareInventory."/>
                <Annotation Term="Redfish.Revisions">
                    <Collection>
                        <Record>
                            <PropertyValue Property="Kind" EnumMember="Redfish.RevisionKind/Added"/>
                            <PropertyValue Property="Version" String="v1_0_0"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Action>
        </Schema>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="DellOemSoftwareInventory.v1_0_0">
            <Annotation Term="OData.Description" String="This version was created to consolidate DellPluginInventory properties and actions into DellOemSoftwareInventory."/>
            <Annotation Term="OData.LongDescription" String="This version consolidates DellPluginInventory schema (properties and actions) into DellOemSoftwareInventory for unified OEM extensions. Provides backward compatibility through URI aliasing."/>

            <!-- ComplexType with all DellPluginInventory properties and AppliesToPCIeIDs -->
            <ComplexType Name="DellOemSoftwareInventory" BaseType="DellOemSoftwareInventory.DellOemSoftwareInventory">

                <!-- Properties for DellPluginInventory -->
                <Property Name="PluginEnabled" Type="Edm.Boolean">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
                    <Annotation Term="OData.Description" String="The state of the plugin true when enabled, false when disabled."/>
                    <Annotation Term="OData.LongDescription" String="The state of the plugin true when enabled, false when disabled."/>
                </Property>
                <Property Name="PluginSizeKB" Type="Edm.Decimal">
                    <Annotation Term="OData.Description" String="Plugin File System size reported in terms of KB."/>
                    <Annotation Term="OData.LongDescription" String="This property shall contain File System size reported in terms of KB."/>
                </Property>
                <Property Name="PluginStatus" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The current status of the plugin."/>
                    <Annotation Term="OData.LongDescription" String="The current status of the plugin."/>
                </Property>
                <Property Name="PluginResourceRSS" Type="Edm.Decimal">
                    <Annotation Term="OData.Description" String="The plugin process memory utilization."/>
                    <Annotation Term="OData.LongDescription" String="The plugin process memory utilization."/>
                </Property>
                <Property Name="PluginResourceCPUTime" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The cumulative CPU utilization of the process."/>
                    <Annotation Term="OData.LongDescription" String="The cumulative CPU utilization of the process."/>
                </Property>
                <Property Name="PluginResourceElapsedRuntime" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The amount of wall clock time the process has been running."/>
                    <Annotation Term="OData.LongDescription" String="The amount of wall clock time the process has been running."/>
                </Property>

                <!-- Properties for LocalImageStore -->
                <Property Name="FileName" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The DUP package file name."/>
                    <Annotation Term="OData.LongDescription" String="The DUP package file name as extracted from lc_validator_output.xml Files.FileDetails@name."/>
                </Property>
                <Property Name="PackageVersion" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The DUP package version."/>
                    <Annotation Term="OData.LongDescription" String="The DUP package version (also serves as available version for GUI display) from lc_validator_output.xml Files.FileDetails@packageVersion."/>
                </Property>
                <Property Name="Criticality" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The criticality level: Recommended, Critical, or Optional."/>
                    <Annotation Term="OData.LongDescription" String="The criticality level from lc_validator_output.xml Files.FileDetails@Criticality (server-side enum conversion: 1=Recommended, 2=Critical, 3=Optional)."/>
                </Property>
                <Property Name="RebootType" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The reboot type required: NONE, IDRAC, HOST, or CHASSIS."/>
                    <Annotation Term="OData.LongDescription" String="The reboot type required from lc_validator_output.xml Files.FileDetails@RebootType."/>
                </Property>
                <Property Name="TargetFQDD" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The target device FQDD."/>
                    <Annotation Term="OData.LongDescription" String="The target device FQDD from lc_validator_output.xml Files.FileDetails.Device@target."/>
                </Property>
                <Property Name="ComponentID" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The component identifier."/>
                    <Annotation Term="OData.LongDescription" String="The component identifier from lc_validator_output.xml Files.FileDetails.Device@ComponentID."/>
                </Property>
                <Property Name="ComponentName" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The component display name."/>
                    <Annotation Term="OData.LongDescription" String="The component display name from lc_validator_output.xml Files.FileDetails.Device.Component@name."/>
                </Property>
                <Property Name="CurrentVersion" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The currently installed firmware version."/>
                    <Annotation Term="OData.LongDescription" String="The currently installed firmware version from lc_validator_output.xml Files.FileDetails.Device.Component@version."/>
                </Property>
                <Property Name="UnmetHardRequisites" Type="Edm.Int64">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Count of unmet hard prerequisites."/>
                    <Annotation Term="OData.LongDescription" String="Count of unmet hard prerequisites from lc_validator_output.xml PrerequisiteInfo@iUnmetHardRequisites."/>
                </Property>
                <Property Name="UnmetSoftRequisites" Type="Edm.Int64">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Count of unmet soft prerequisites."/>
                    <Annotation Term="OData.LongDescription" String="Count of unmet soft prerequisites from lc_validator_output.xml PrerequisiteInfo@iUnmetSoftRequisites."/>
                </Property>
                <Property Name="PrerequisiteMessages" Type="Collection(DellOemSoftwareInventory.v1_0_0.PrerequisiteMessage)">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Array of prerequisite message details."/>
                    <Annotation Term="OData.LongDescription" String="Array of prerequisite message details from lc_validator_output.xml PrerequisiteInfo.Messages.*."/>
                </Property>
                <Property Name="PackageValidationStatus" Type="Edm.String">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="The LC validator status: Starting, Success, or Failure."/>
                    <Annotation Term="OData.LongDescription" String="The LC validator status from the redownloader state machine. Starting = upload/validation in progress. Success = validated and ready for installation. Failure = validation failed."/>
                </Property>
                <Property Name="ValidationMessage" Type="Edm.String" Nullable="true">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Error message when validation fails. Only present when PackageValidationStatus = Failure."/>
                    <Annotation Term="OData.LongDescription" String="Error message when validation fails (e.g., RED034, RED098, RED106, SYS017 text). Not present when PackageValidationStatus = Success."/>
                </Property>
                <Property Name="ComponentNames" Type="Collection(Edm.String)">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Array of all component names for multi-component DUPs."/>
                    <Annotation Term="OData.LongDescription" String="Array of all component display names from lc_validator_output.xml Files.FileDetails.Device.Component@name elements. For multi-component DUPs, contains all components. For single-component DUPs, contains one element matching ComponentName."/>
                </Property>
                <Property Name="ComponentVersions" Type="Collection(Edm.String)">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Array of all component versions for multi-component DUPs."/>
                    <Annotation Term="OData.LongDescription" String="Array of all component versions from lc_validator_output.xml Files.FileDetails.Device.Component@version elements. Parallel array to ComponentNames - each version corresponds to the component at the same index."/>
                </Property>

                <!-- Added standarded Oem extention property AppliesToPCIeIDs -->
                <Property Name="AppliesToPCIeIDs" Type="Collection(Edm.String)">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Array of PCIe IDs for all physical devices consolidated into this FirmwareInventory URI. Format: VendorID:DeviceID:SubVendorID:SubDeviceID in hex."/>
                    <Annotation Term="OData.LongDescription" String="Array of PCIe IDs for all physical devices that map to this consolidated FirmwareInventory URI. Each element is formatted as VendorID:DeviceID:SubVendorID:SubDeviceID in hexadecimal (zero-padded to 4 digits, uppercase, no 0x prefix). Absent for non-PCIe devices such as BIOS, iDRAC, TPM, and PSU."/>
                </Property>
                <Property Name="HostResetRequiredOnUpdate" Type="Edm.Boolean">
                    <Annotation Term="OData.Permissions" EnumMember="OData.Permission/Read"/>
                    <Annotation Term="OData.Description" String="Indicates whether a host reset is required after the update."/>
                    <Annotation Term="OData.LongDescription" String="This property shall indicate whether a host reset is required after the firmware update is applied."/>
                </Property>
            </ComplexType>

            <!-- ComplexType for PrerequisiteMessage -->
            <ComplexType Name="PrerequisiteMessage">
                <Annotation Term="OData.Description" String="A prerequisite message with details about unmet requirements."/>
                <Annotation Term="OData.LongDescription" String="A prerequisite message with details about unmet requirements including message ID, text, unmet type, and severity."/>
                <Property Name="MessageId" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The message identifier."/>
                </Property>
                <Property Name="Message" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The message text."/>
                </Property>
                <Property Name="UnmetType" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The unmet type: Hard or Soft."/>
                </Property>
                <Property Name="Severity" Type="Edm.String">
                    <Annotation Term="OData.Description" String="The severity level."/>
                </Property>
            </ComplexType>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>