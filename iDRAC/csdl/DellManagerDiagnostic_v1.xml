      <Action Name="GetInterfaceConfiguration" IsBound="true">
        <Parameter Name="DellManagerDiagnostic" Type="ManagerDiagnosticData.v1_0_0.OemActions" Nullable="false"/>
        <Annotation Term="OData.Description" String="Display network interface parameters."/>
        <Annotation Term="OData.LongDescription" String="This action shall display network interface configuration. Returns network interface output showing all network interfaces with IP addresses, MAC addresses, and statistics."/>
        <ReturnType Type="DellManagerDiagnostic.v1_0_0.CommandResponse" Nullable="false"/>
      </Action>

      <Action Name="GetTraceLog" IsBound="true">
        <Parameter Name="DellManagerDiagnostic" Type="ManagerDiagnosticData.v1_0_0.OemActions" Nullable="false"/>
        <Annotation Term="OData.Description" String="Display trace log information."/>
