    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="DellManagerDiagnostic">
      <Annotation Term="Redfish.OwningEntity" String="Dell"/>

      <!-- Individual OEM Actions for ManagerDiagnosticData -->
      <Action Name="Ping" IsBound="true">
        <Parameter Name="DellManagerDiagnostic" Type="ManagerDiagnosticData.v1_0_0.OemActions" Nullable="false"/>
        <Parameter Name="IPAddress" Type="Edm.String" Nullable="false" MaxLength="253">
          <Annotation Term="OData.Description" String="IP address to ping."/>
          <Annotation Term="OData.LongDescription" String="The target IP address or domain name to test network connectivity. Must be valid IPv4, IPv6 address format, or domain name."/>
          <Annotation Term="Redfish.Required"/>
          <Annotation Term="Validation.Pattern" String="^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$|^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$"/>
        </Parameter>
        <Parameter Name="Count" Type="Edm.Int32" Nullable="true" DefaultValue="1">
          <Annotation Term="OData.Description" String="Number of ping packets to send."/>
          <Annotation Term="OData.LongDescription" String="The number of ping packets to send to the target IP address. Must be between 1 and 10. Default is 1. Values outside this range will be rejected."/>
          <Annotation Term="Validation.Minimum" Int="1"/>
          <Annotation Term="Validation.Maximum" Int="10"/>
        </Parameter>
        <Annotation Term="OData.Description" String="Test network connectivity."/>
        <Annotation Term="OData.LongDescription" String="This action shall test network connectivity to the specified IP address or domain name with count range checking (1-10). Returns network connectivity test output."/>
        <ReturnType Type="DellManagerDiagnostic.v1_0_0.CommandResponse" Nullable="false"/>
      </Action>

      <Action Name="GetArpTable" IsBound="true">
        <Parameter Name="DellManagerDiagnostic" Type="ManagerDiagnosticData.v1_0_0.OemActions" Nullable="false"/>
        <Annotation Term="OData.Description" String="Display the ARP cache."/>
        <Annotation Term="OData.LongDescription" String="This action shall display ARP table entries. Returns ARP table output with numeric IP addresses and MAC addresses."/>
        <ReturnType Type="DellManagerDiagnostic.v1_0_0.CommandResponse" Nullable="false"/>
