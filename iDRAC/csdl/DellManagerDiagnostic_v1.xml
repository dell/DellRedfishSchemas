        <Annotation Term="OData.Description" String="Display network connections and routing tables."/>
        <Annotation Term="OData.LongDescription" String="This action shall display network statistics and connection information. Returns network statistics output showing all active connections."/>
        <ReturnType Type="DellManagerDiagnostic.v1_0_0.CommandResponse" Nullable="false"/>
