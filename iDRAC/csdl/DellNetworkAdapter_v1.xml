                <Parameter Name="NetworkAdapter" Type="NetworkAdapter.v1_3_0.OemActions" Nullable="false"/>
                <Parameter Name="IPAddress" Type="Edm.String">
                    <Annotation String="IP address of the network share such as 192.168.10.12. The parameter is required if the ShareType parameter has value of FTP, NFS, CIFS, HTTP, TFTP or HTTPS." Term="OData.Description"/>
                    <Annotation String="IP address of the network share such as 192.168.10.12. The parameter is required if the ShareType parameter has value of FTP, NFS, CIFS, HTTP, TFTP or HTTPS." Term="OData.LongDescription"/>
                </Parameter>
                <Parameter Name="UserName" Type="Edm.String">
                    <Annotation String="UserName for Network share authentication." Term="OData.Description"/>
                    <Annotation String="UserName for Network share authentication." Term="OData.LongDescription"/>
                </Parameter>
                <Parameter Name="Password" Type="Edm.String">
                    <Annotation String="Password to access Network Share." Term="OData.Description"/>
                    <Annotation String="Password to access Network Share." Term="OData.LongDescription"/>
                </Parameter>
                <Parameter Name="ShareName" Type="Edm.String" >
                    <Annotation String="Name of the Network Share." Term="OData.Description"/>
                    <Annotation String="Name of the Network Share." Term="OData.LongDescription"/>
                </Parameter>
