        "ExecutionModes": {
            "enum": [
                "Default",
                "DeployOnSledInsert",
                "InstantDeploy"
            ],
            "enumDescriptions": {
                "Default": "Default execution mode",
                "DeployOnSledInsert": "Deploy the imported configuration on inserting the Sled",
                "InstantDeploy": "Deploy the imported configuration instantly"
            },
            "enumLongDescriptions": {
                "Default": "Default execution mode",
                "DeployOnSledInsert": "Deploy the imported configuration on inserting the Sled",
                "InstantDeploy": "Deploy the imported configuration instantly"
