                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "target": {
                    "description": "Link to invoke action",
                    "format": "uri-reference",
                    "type": "string"
                },
                "title": {
                    "description": "Friendly action name",
                    "type": "string"
                }
            },
            "type": "object"
        },
        "ExportUse": {
            "enum": [
                "Default",
                "Clone",
                "Replace"
            ],
            "type": "string"
        },
        "GetRedfishResources": {
            "actionResponse": {
                "$ref": "#/definitions/GetRedfishResourcesResponse"
            },
            "additionalProperties": false,
            "description": "Retrieve Redfish resources for a set of endpoints, possibly using wildcards.",
            "longDescription": "This action retrieves the Redfish resources for the specified endpoints. The action may return partial results if the operation exceeds the specified timeout.",
            "parameters": {
                "EndPoints": {
                    "description": "A collection of URL paths using a file path syntax.",
                    "items": {
                        "type": "string"
                    },
                    "longDescription": "A collection of URL paths using a file path syntax. Wildcards may be used.",
                    "requiredParameter": true,
                    "type": "array"
                },
                "MaxURIs": {
                    "description": "Maximum number of expanded URIs the service will process.",
                    "longDescription": "After wildcard expansion, the service will process at most this many URIs. Any additional URIs will be returned in PendingEndpoints.",
                    "maximum": 200,
                    "minimum": 1,
                    "type": "integer"
                },
                "TimeoutSeconds": {
                    "description": "Maximum time allowed to resolve all URIs. If exceeded, the action returns partial data.",
                    "longDescription": "If the operation exceeds this timeout, the action returns partial results along with PendingEndpoints so the remaining endpoints can be retried.",
                    "maximum": 30,
                    "minimum": 1,
                    "type": "integer",
                    "units": "s"
                }
            },
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "description": "This property shall specify a valid odata or Redfish property.",
                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "target": {
                    "description": "Link to invoke action",
                    "format": "uri-reference",
                    "type": "string"
                },
                "title": {
                    "description": "Friendly action name",
                    "type": "string"
                }
            },
            "type": "object",
            "versionAdded": "v1_6_0"
        },
        "GetRedfishResourcesResponse": {
            "additionalProperties": false,
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "description": "This property shall specify a valid odata or Redfish property.",
                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "Data": {
                    "$ref": "#/definitions/RedfishResourceData",
                    "description": "A key-value dictionary where keys are exact Redfish URIs and values are the JSON data.",
                    "longDescription": "This property shall contain a mapping of Redfish resource URIs to the retrieved JSON payloads.",
                    "versionAdded": "v1_6_0"
                },
                "FailedEndPoints": {
                    "description": "The URLs that could not be retrieved due to errors.",
                    "items": {
                        "type": "string"
                    },
                    "longDescription": "This property shall contain the URLs that failed to be retrieved due to non-timeout errors and cannot be processed.",
                    "type": "array",
                    "versionAdded": "v1_6_0"
                },
                "PendingEndpoints": {
                    "description": "If the action returned partial data, the remaining URLs can be retried using these values.",
                    "items": {
                        "type": "string"
                    },
                    "longDescription": "In case the action returned partial results, this property shall contain the URLs that can be passed back in EndPoints to fetch the remaining data.",
                    "type": "array",
                    "versionAdded": "v1_6_0"
                }
            },
            "type": "object"
        },
        "HostPowerState": {
            "enum": [
                "On",
                "Off"
            ],
