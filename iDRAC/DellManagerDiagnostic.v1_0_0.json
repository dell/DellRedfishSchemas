        "Ping": {
            "actionResponse": {
                "$ref": "#/definitions/CommandResponse"
            },
            "additionalProperties": false,
            "description": "Test network connectivity.",
            "longDescription": "This action shall test network connectivity to the specified IP address or domain name with count range checking (1-10). Returns network connectivity test output.",
            "parameters": {
                "Count": {
                    "description": "Number of ping packets to send.",
                    "longDescription": "The number of ping packets to send to the target IP address. Must be between 1 and 10. Default is 1. Values outside this range will be rejected.",
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer"
                },
                "IPAddress": {
                    "description": "IP address to ping.",
                    "longDescription": "The target IP address or domain name to test network connectivity. Must be valid IPv4, IPv6 address format, or domain name.",
                    "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$|^[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?)*$",
                    "requiredParameter": true,
                    "type": "string"
                }
            },
