{
    "$id": "https://raw.githubusercontent.com/dell/DellRedfishSchemas/refs/heads/main/iDRAC/DellPrivileges.v1_0_0.json",
    "$ref": "#/definitions/DellPrivileges",
    "$schema": "http://redfish.dmtf.org/schemas/v1/redfish-schema-v1.json",
    "copyright": "Copyright 2014-2026 Dell, Inc. or its subsidiaries. All Rights Reserved.",
    "definitions": {
        "DellPrivileges": {
            "additionalProperties": false,
            "description": "A custom OEM privilege resource.",
            "longDescription": "A custom OEM privilege resource for privilege management.",
            "patternProperties": {
                "^([a-zA-Z_][a-zA-Z0-9_]*)?@(odata|Redfish|Message)\\.[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "description": "This property shall specify a valid odata or Redfish property.",
                    "type": [
                        "array",
                        "boolean",
                        "integer",
                        "number",
                        "null",
                        "object",
                        "string"
                    ]
                }
            },
            "properties": {
                "@odata.context": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/context"
                },
                "@odata.etag": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/etag"
                },
                "@odata.id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/id"
                },
                "@odata.type": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/odata-v4.json#/definitions/type"
                },
                "Description": {
                    "anyOf": [
                        {
                            "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Description"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "readonly": true
                },
                "Id": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Id",
                    "readonly": true
                },
                "IsPredefined": {
                    "description": "Indicates if this is a predefined privilege.",
                    "longDescription": "This property shall indicate if this privilege is predefined and cannot be deleted. Predefined privileges include DMTF standard privileges and OEM predefined privileges.",
                    "readonly": true,
                    "type": "boolean"
                },
                "Name": {
                    "$ref": "http://redfish.dmtf.org/schemas/v1/Resource.json#/definitions/Name",
                    "readonly": true
                },
                "Ownership": {
                    "$ref": "#/definitions/OwnershipType",
                    "description": "The ownership type of this privilege.",
                    "longDescription": "This property shall contain the ownership type indicating whether this is a DMTF standard, OEM predefined, or Custom user-created privilege.",
                    "readonly": true
                },
                "PrivilegeId": {
                    "description": "The unique identifier for this privilege.",
                    "longDescription": "The unique identifier for this privilege. This property shall be alphanumeric, start with a character, and have a maximum length of 32 characters.",
                    "readonly": true,
                    "type": "string"
                }
            },
            "required": [
                "PrivilegeId",
                "@odata.id",
                "@odata.type",
                "Id",
                "Name"
            ],
            "requiredOnCreate": [
                "PrivilegeId"
            ],
            "type": "object"
        },
        "OwnershipType": {
            "enum": [
                "DMTF",
                "OEM",
                "Custom"
            ],
            "enumDescriptions": {
                "Custom": "Custom user-created privilege.",
                "DMTF": "Standard DMTF privilege.",
                "OEM": "OEM predefined privilege."
            },
            "type": "string"
        }
    },
    "owningEntity": "Dell",
    "title": "#DellPrivileges.v1_0_0.DellPrivileges"
}